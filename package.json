{
  "name": "agent-hive",
  "version": "0.5.9",
  "license": "MIT",
  "description": "Self-hosted coding agent server: pi in throwaway microVMs, behind a small Fastify API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "hive": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "build:ui": "cd ui && npm ci && npm run build",
    "build:image": "podman build -t localhost/agent-hive-sandbox:latest image/",
    "build:image:fresh": "podman build --pull=always --no-cache -t localhost/agent-hive-sandbox:latest image/",
    "build:vm": "bash vm/build.sh",
    "build:rootfs": "bash vm/build-rootfs.sh",
    "build:rootfs-image": "bash scripts/build-rootfs-image.sh",
    "build:native:macos": "bash scripts/build-native-macos.sh",
    "smoke:macos": "node scripts/macos-smoke.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "start": "node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.0.0",
    "dotenv": "^18.0.10",
    "fastify": "^5.0.0",
    "sigstore": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.5.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
